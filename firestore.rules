rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app writes to "histories" without a login, so this collection must be open.
    // Anyone who knows your site URL + project id could read it. See SETUP.md to lock it down.
    match /histories/{doc} {
      allow read, write: if true;
    }
  }
}
